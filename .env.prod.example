# =============================================================================
# Variables d'environnement pour le déploiement Docker en production.
#
# Usage :
#   1. Copier ce fichier en `.env` à côté de `docker-compose.prod.yml` sur le VPS
#   2. Remplir toutes les valeurs marquées "REMPLIR"
#   3. Vérifier les permissions : chmod 600 .env
#   4. NE JAMAIS committer le `.env` réel (déjà dans .gitignore)
#
# Astuce génération mots de passe forts :
#   openssl rand -base64 32
# =============================================================================


# -----------------------------------------------------------------------------
# Image Docker (GHCR)
# -----------------------------------------------------------------------------

# Propriétaire (user ou organisation) GitHub où l'image est publiée.
# Doit correspondre exactement au nom utilisé lors du `docker push ghcr.io/<user>/takalo-backend`.
GITHUB_USER=REMPLIR

# Tag de l'image à tirer. `latest` = toujours la dernière build.
# Pour pinner une version précise (recommandé en prod) : 1.0.0, sha-abc123, etc.
# Changer cette valeur + `docker compose pull app && up -d app` permet de rollback en 30s.
APP_VERSION=latest


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# Utilisateur applicatif PostgreSQL. Crée à la première initialisation du conteneur.
# Accessible uniquement depuis le réseau Docker interne (pas exposé sur Internet).
DB_USER=takalo

# Mot de passe PostgreSQL. OBLIGATOIRE — pas de valeur par défaut.
# Utiliser un secret long (≥ 24 caractères, généré aléatoirement).
DB_PASSWORD=REMPLIR


# -----------------------------------------------------------------------------
# Keycloak — bootstrap admin
# -----------------------------------------------------------------------------

# Compte super-admin créé au premier démarrage de Keycloak (realm "master").
# Utilisé UNIQUEMENT pour la première connexion à la console d'admin.
# Une fois le realm `takalo` configuré, créer un compte admin nominatif et désactiver/changer celui-ci.
KEYCLOAK_ADMIN_USER=admin

# Mot de passe du super-admin Keycloak. OBLIGATOIRE.
# Comme pour la DB : générer aléatoirement.
KEYCLOAK_ADMIN_PASSWORD=REMPLIR
